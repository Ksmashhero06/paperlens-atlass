# PaperLens Atlas — Frontend Environment Configuration Template

# ─────────────────────────────────────────────────────────────────────────────
# Backend API
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Gemini API Key (used server-side for grounded research Q&A)
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (Cloud PostgreSQL database)
# Get these from: https://supabase.com → Project → Settings → API
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Next.js aliases (used if migrating from Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
